# 1. 用CURDIR替代pwd
export ARMINO_AVDK_DIR := $(CURDIR)
ARMINO_IDK_DIR := $(CURDIR)/bk_idk
ARMINO_TOOL := @$(ARMINO_IDK_DIR)/tools/build_tools/armino
ARMINO_TOOL_WRAPPER := @$(ARMINO_IDK_DIR)/tools/build_tools/build.sh

# 2. soc_targets手动维护（如需自动化建议用Python脚本生成）
# bk7231n bk7258_cp1 bk7235m bk7256 bk7236_cp1 bk7239_cp1 bk7239 bk7286_cp1 bk7236 bk7235 bk7235_cp1 bk7258 bk7256_cp1 bk7258_cp2 bk723L bk7234 bk7286
soc_targets := bk7231n bk7258_cp1 bk7235m bk7256 bk7236_cp1 bk7239_cp1 bk7239 bk7286_cp1 bk7236 bk7235 bk7235_cp1 bk7258 bk7256_cp1 bk7258_cp2 bk723L bk7234 bk7286

cmake_not_supported_targets = help clean doc
all_targets = cmake_not_supported_targets soc_targets cmake_supported_targets
export SOC_SUPPORTED_TARGETS := ${soc_targets}

export ARMINO_SOC := $(findstring $(MAKECMDGOALS), $(soc_targets))
export CMD_TARGET := $(MAKECMDGOALS)

ifeq ("$(APP_VERSION)", "")
	export APP_VERSION := unknownn
else
	export APP_VERSION := test
endif

ifeq ("$(PROJECT)", "")
	export PROJECT := media/doorbell
else
	export PROJECT := $(PROJECT)
endif

ifeq ("$(PROJECT_DIR)", "")
	PROJECT_DIR := ../projects/$(PROJECT)
else
	PROJECT_DIR := $(PROJECT_DIR)
endif

ifeq ("$(ARMINO_SOC)", "")
ifeq ("$(ARMINO_SOC_LIB)", "")
	ARMINO_SOC := bk7256
	ARMINO_TARGET := $(MAKECMDGOALS)
endif
else
	ARMINO_TARGET := build
endif

PROJECT_NAME := $(notdir $(PROJECT_DIR))
ifdef BUILD_DIR
	PROJECT_BUILD_DIR := $(BUILD_DIR)
else
	PROJECT_BUILD_DIR := ../build/$(PROJECT_NAME)
endif

.PHONY: all_targets

help:
	@echo.
	@echo " make bkxxx - build soc bkxxx"
	@echo " make all - build all soc"
	@echo " make clean - clean build"
	@echo " make help - display this help info"
	@echo " make doc - generate avdk doc"
	@echo.

common:
	@echo ARMINO_SOC is set to $(ARMINO_SOC)
	@echo ARMINO_TARGET is set to $(ARMINO_TARGET)
	@echo armino project path=$(PROJECT_DIR)
	@echo armino path=$(ARMINO_IDK_DIR)
	@echo armino build path=$(PROJECT_BUILD_DIR)

all: $(soc_targets)

$(soc_targets): common
	@make $(ARMINO_SOC) PROJECT_DIR=$(PROJECT_DIR) BUILD_DIR=$(PROJECT_BUILD_DIR) APP_NAME=$(APP_NAME) APP_VERSION=$(APP_VERSION) -C $(ARMINO_IDK_DIR)

# 3. Python命令兼容
ifeq ($(OS),Windows_NT)
    PYTHON = python
    RM = rmdir /S /Q
    DEL = del /Q
else
    PYTHON = python3
    RM = rm -rf
    DEL = rm -f
endif

doc:
	@$(PYTHON) ./tools/armino_doc.py

clean:
	@echo Cleaning build...
	@$(PYTHON) ./tools/armino_doc.py clean
	@$(RM) build
	@$(RM) bk_idk/build

debug-components:
	@echo "==================== DEBUG: COMPONENT DIRECTORIES ===================="
	@echo "Checking for components in bk_idk/components directory:"
	@for dir in $(wildcard bk_idk/components/*/); do \
		if [ -f "$$dir/CMakeLists.txt" ]; then \
			echo "  Component: $$(basename $$dir)"; \
			if grep -q "armino_component_register" "$$dir/CMakeLists.txt"; then \
				echo "    Status: Has armino_component_register"; \
			else \
				echo "    Status: No armino_component_register found"; \
			fi; \
			echo "    Path: $$dir"; \
		fi; \
	done
	@echo "==================== END DEBUG ===================="

debug-specific:
	@echo "==================== DEBUG: SPECIFIC COMPONENTS ===================="
	@echo "Checking for 'common' component:"
	@if [ -d "bk_idk/components/common" ]; then \
		echo "  Found: bk_idk/components/common"; \
		if [ -f "bk_idk/components/common/CMakeLists.txt" ]; then \
			echo "  Has CMakeLists.txt: Yes"; \
			grep -n "armino_component_register" "bk_idk/components/common/CMakeLists.txt" || echo "  No armino_component_register found"; \
		else \
			echo "  Has CMakeLists.txt: No"; \
		fi; \
	else \
		echo "  Found: No"; \
	fi
	@echo ""
	@echo "Checking for 'bk_common' component:"
	@if [ -d "bk_idk/components/bk_common" ]; then \
		echo "  Found: bk_idk/components/bk_common"; \
		if [ -f "bk_idk/components/bk_common/CMakeLists.txt" ]; then \
			echo "  Has CMakeLists.txt: Yes"; \
			grep -n "armino_component_register" "bk_idk/components/bk_common/CMakeLists.txt" || echo "  No armino_component_register found"; \
		else \
			echo "  Has CMakeLists.txt: No"; \
		fi; \
	else \
		echo "  Found: No"; \
	fi
	@echo ""
	@echo "Checking for 'release' component:"
	@if [ -d "bk_idk/components/release" ]; then \
		echo "  Found: bk_idk/components/release"; \
		if [ -f "bk_idk/components/release/CMakeLists.txt" ]; then \
			echo "  Has CMakeLists.txt: Yes"; \
			grep -n "armino_component_register" "bk_idk/components/release/CMakeLists.txt" || echo "  No armino_component_register found"; \
		else \
			echo "  Has CMakeLists.txt: No"; \
		fi; \
	else \
		echo "  Found: No"; \
	fi
	@echo "==================== END DEBUG ===================="